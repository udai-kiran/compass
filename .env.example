# Compass (PennyPilot) — environment configuration
# Copy to .env and adjust. The API validates all of these at boot (task 0.2).

# --- Infrastructure (external services) ---
# Postgres — set user/password/db to match your server
DATABASE_URL=postgresql://compass:CHANGE_ME@192.168.2.196:5432/compass
# Redis — sessions, BullMQ jobs, caching
REDIS_URL=redis://192.168.2.196:6379/0

# --- App ---
PORT=3001
SESSION_SECRET=CHANGE_ME_32_CHAR_RANDOM_STRING
STORAGE_DIR=./data/attachments
BACKUP_DIR=./data/backups
# Encryption key for scheduled backups (falls back to SESSION_SECRET if empty)
BACKUP_KEY=

# --- Owner account ---
# Provisioned by the compose `migrate` service on first deploy (idempotent —
# re-running never changes an existing owner's password). Registration is
# closed, so this is the only way an account is created.
OWNER_EMAIL=udaikiran@outlook.com
# Required. Minimum 8 characters. Never commit the real value — .env is gitignored.
OWNER_PASSWORD=CHANGE_ME

# --- Security hardening ---
# Extra browser origins allowed for state-changing requests (comma-separated).
# Only needed when the SPA is served from a different host than the API.
TRUSTED_ORIGINS=
# Set true to disable Redis-backed rate limiting (e.g. for load tests)
RATE_LIMIT_DISABLED=false

# --- AI (optional — app is fully functional with AI_PROVIDER=none) ---
AI_PROVIDER=none            # none | anthropic | ollama | openrouter | deepseek
ANTHROPIC_API_KEY=          # required only when AI_PROVIDER=anthropic
ANTHROPIC_MODEL=            # optional override, default claude-haiku-4-5-20251001
OLLAMA_BASE_URL=            # required only when AI_PROVIDER=ollama, e.g. http://192.168.2.196:11434
OLLAMA_MODEL=               # optional override, default llama3.1
OPENROUTER_API_KEY=         # required only when AI_PROVIDER=openrouter (https://openrouter.ai/keys)
OPENROUTER_MODEL=           # optional override, default deepseek/deepseek-chat
DEEPSEEK_API_KEY=           # required only when AI_PROVIDER=deepseek (https://platform.deepseek.com)
DEEPSEEK_MODEL=             # optional override, default deepseek-chat

# --- Email ingestion pipeline (ingestor + extractor containers) ---
# extractor: needs a real AI provider above (AI_PROVIDER != none)
EXTRACT_CONCURRENCY=4       # extractor: emails processed in parallel
# ingestor: reads mail over OAuth2 IMAP and enqueues to the extractor
MAILBOX_SECRET=             # encrypts stored refresh tokens; falls back to SESSION_SECRET (>=32 chars)
POLL_INTERVAL_SECONDS=120   # how often the ingestor re-checks each mailbox
GOOGLE_CLIENT_ID=           # Google OAuth "Web application" client (for XOAUTH2 + `npm run connect`)
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_PORT=53682   # loopback redirect port for the one-time `connect` flow

# Host port for the web UI (docker compose)
WEB_PORT=8090
