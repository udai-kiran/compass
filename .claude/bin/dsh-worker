#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat >&2 <<'EOF'
Usage: dsh-worker <report-path> '<task prompt>' [persona-name]

  <report-path>  file the implementation report is written to, e.g.
                 tasks/001-short-name/implementation-1.md
                 Relative paths resolve against the repository root.
                 An existing file is never overwritten: reports are
                 append-only history, so use the next iteration number.

  [persona-name] optional; the basename (no .md) of a file under
                 .claude/agents/, e.g. 'frontend-developer'. Its body (YAML
                 frontmatter stripped) is prepended to the task prompt as
                 domain guidance. Errors if the file doesn't exist.

Environment:
  DSH_WORKER_PROFILE   dsh profile to boot (default: headless)

Runs 'npx @deepseek-ai/dsh --profile <profile> <task prompt>' (dsh's headless
profile has no dedicated model/output-file flags; model and permission
behavior come from the profile's own config under $DSH_HOME/profiles, not
from this script).
EOF
}

if [[ $# -lt 2 || $# -gt 3 || -z "$1" || -z "$2" ]]; then
    usage
    exit 2
fi

dest="$1"
prompt="$2"
persona="${3:-}"

if ! command -v npx >/dev/null 2>&1; then
    echo "error: npx not found on PATH (dsh is invoked via 'npx @deepseek-ai/dsh')" >&2
    exit 127
fi

repo_root="$(git rev-parse --show-toplevel)"

persona_text=""
if [[ -n "$persona" ]]; then
    persona_file="$repo_root/.claude/agents/${persona}.md"
    if [[ ! -f "$persona_file" ]]; then
        echo "error: persona file not found: $persona_file" >&2
        exit 2
    fi
    # Strip the leading YAML frontmatter block (--- ... ---), if present.
    persona_body="$(awk '
        NR==1 && $0=="---" { infm=1; next }
        infm && $0=="---" { infm=0; next }
        infm { next }
        { print }
    ' "$persona_file")"
    persona_text="--- DOMAIN GUIDANCE (from the '$persona' persona, not the requester) ---
Apply the following specialist's domain expertise and checklists to the task
below. Where it conflicts with the OUTPUT REQUIREMENTS further down, the
OUTPUT REQUIREMENTS win — they govern how you report, not what you build.

${persona_body}

--- TASK ---
"
fi

# Canonicalize a path: use realpath if available, else manual resolution
canonicalize() {
    local p="$1"
    if command -v realpath >/dev/null 2>&1; then
        realpath "$p"
    elif [[ -d "$p" ]]; then
        (cd "$p" && pwd -P)
    else
        (cd "$(dirname "$p")" && printf '%s/%s\n' "$(pwd -P)" "$(basename "$p")")
    fi
}

# Test if a directory is outside the repo (not equal to repo_root, not a descendant)
dir_is_outside_repo() {
    local dir="$1"
    local canon_dir
    canon_dir="$(canonicalize "$dir")"
    case "$canon_dir" in
        "$repo_root_canon"/*|"$repo_root_canon") return 1 ;;
        *) return 0 ;;
    esac
}

repo_root_canon="$(canonicalize "$repo_root")"

# The caller names the destination; relative paths are repo-root-relative so
# that `tasks/<task>/implementation-<n>.md` means the same thing from any working dir.
[[ "$dest" == /* ]] || dest="$repo_root/$dest"

if [[ -e "$dest" ]]; then
    echo "error: report path already exists: $dest" >&2
    echo "       reports are append-only; use the next iteration number" >&2
    exit 1
fi

if ! mkdir -p "$(dirname "$dest")"; then
    echo "error: cannot create report directory: $(dirname "$dest")" >&2
    exit 1
fi

# dsh's headless profile prints only the final assistant message to stdout and
# has no --output-file flag of its own, so we capture stdout ourselves into a
# staging file outside the repo, then install it as the report. This keeps the
# capture clean regardless of what dsh does inside the working tree.
report_file=""
candidates=("${TMPDIR:-}" "/tmp")
[[ -n "${HOME:-}" ]] && candidates+=("$HOME/.cache")

for candidate in "${candidates[@]}"; do
    # Skip if empty
    [[ -z "$candidate" ]] && continue

    # Ensure directory exists (create if needed for ~/.cache)
    if [[ "$candidate" == "${HOME:-}/.cache" ]]; then
        mkdir -p "$candidate" 2>/dev/null || continue
    fi

    # Skip if nonexistent
    [[ -d "$candidate" ]] || continue

    # Check if outside repo
    dir_is_outside_repo "$candidate" || continue

    # Test writability by attempting mktemp
    if report_file="$(mktemp "${candidate%/}/dsh-worker.XXXXXX.md" 2>/dev/null)" && [[ -n "$report_file" ]]; then
        break
    fi
done

if [[ -z "$report_file" ]]; then
    echo "error: cannot find a writable temp directory outside the repository" >&2
    exit 1
fi

trap 'rm -f "$report_file"' EXIT

echo "dsh worker target: $dest" >&2

profile="${DSH_WORKER_PROFILE:-headless}"

# The worker IS allowed to modify files. The prompt guard ensures the final
# assistant message is a complete implementation report suitable for
# coordinator review.
prompt_guard='

--- OUTPUT REQUIREMENTS (from the worker harness, not the requester) ---
You are an implementation worker. You MAY create, edit, and delete files as
needed to accomplish the task. Your implementation report is captured from your
FINAL ASSISTANT MESSAGE only. Emit the complete report, in full, as that final
message.

Your final message MUST include:
1. A list of every file you created, modified, or deleted
2. A brief summary of each change and why it was made
3. Any commands you ran and their output
4. Any issues, risks, or deviations from the requested task

Do not truncate the report, do not summarise it, and do not say it has been
saved anywhere. The full report must appear as your final message.'

dsh_status=0
(cd "$repo_root" && npx --yes @deepseek-ai/dsh --profile "$profile" -- "${persona_text}${prompt}${prompt_guard}") \
    > "$report_file" || dsh_status=$?

if [[ ! -s "$report_file" ]]; then
    echo "error: dsh produced no report (exit $dsh_status); nothing written to $dest" >&2
    [[ $dsh_status -eq 0 ]] && dsh_status=1
    exit "$dsh_status"
fi

# If dsh created $dest itself despite the guard above, its content is likely
# the real report while our captured final message is a stub. Never clobber it.
if [[ -e "$dest" ]]; then
    echo "error: dsh created $dest itself during the run" >&2
    echo "       refusing to overwrite it with the captured final message" >&2
    echo "       captured final message kept at: $report_file" >&2
    echo "       inspect both, keep the real report, and re-run with a new iteration number" >&2
    trap - EXIT
    exit 1
fi

if ! cp "$report_file" "$dest"; then
    echo "error: cannot write report to $dest; report kept at $report_file" >&2
    trap - EXIT
    exit 1
fi

echo "dsh worker report written to: $dest" >&2
exit "$dsh_status"
